# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=

# Which model to use, as "provider:model". Examples:
#   anthropic:claude-opus-5-5     (most capable)
#   anthropic:claude-sonnet-5-5   (balanced)
#   anthropic:claude-haiku-5-5    (fastest, cheapest)
AI_MODEL=anthropic:claude-opus-5-5

# Port for the chat API (npm run server). The gateway forwards /ai/ here.
PORT=4010

# connection-service, which lists the workspace's connected social accounts.
CONNECTIONS_SERVICE_URL=http://localhost:4002

# post-scheduler-service, which creates and schedules posts.
POST_SCHEDULER_SERVICE_URL=http://localhost:4005

# MongoDB for saved conversations. Defaults to the local Docker MongoDB.
MONGO_URI=mongodb://localhost:27017/ai-assistant
