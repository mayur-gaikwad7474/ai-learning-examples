{
  "name": "ai-service",
  "version": "1.0.0",
  "description": "Learning project: AI agents and tools with the Vercel AI SDK",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "start": "node --env-file=.env src/main.ts",
    "server": "node --watch --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.88",
    "ai": "7.0.153",
    "express": "5.3.0",
    "mongoose": "9.7.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
